{
   "action": {
      "default_title": "BOSS打招呼助手"
   },
   "background": {
      "service_worker": "src/background.js"
   },
   "content_scripts": [ {
      "css": [ "pages/content.css" ],
      "js": [ "src/automation-safety.js", "src/job-id.js", "src/content.js" ],
      "matches": [ "https://www.zhipin.com/*" ],
      "run_at": "document_idle"
   }, {
      "js": [ "src/automation-safety.js", "src/page-bridge.js" ],
      "matches": [ "https://www.zhipin.com/*" ],
      "run_at": "document_start",
      "world": "MAIN"
   } ],
   "description": "AI 筛选 BOSS 岗位，保存待人工沟通的候选和招呼草稿。",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "store-assets/icons/icon128.png",
      "16": "store-assets/icons/icon16.png",
      "32": "store-assets/icons/icon32.png",
      "48": "store-assets/icons/icon48.png"
   },
   "manifest_version": 3,
   "name": "BOSS打招呼助手",
   "permissions": [ "storage", "tabs", "alarms", "unlimitedStorage", "contextMenus" ],
   "version": "1.5.76"
}
